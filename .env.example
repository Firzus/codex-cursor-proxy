# PORT=8787
# CODEX_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex,gpt-5.3-codex-spark,gpt-5.2
# CODEX_MAX_CONCURRENCY=10
# CODEX_DEBUG=1

# Required: a named Cloudflare tunnel. The proxy refuses to start without both.
# Create one with `cloudflared tunnel create <name>` then route the hostname to it.
CLOUDFLARE_TUNNEL_HOSTNAME=proxy.example.com
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token